{
  "name": "androidctl",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Android developer toolkit: colourful CLI and MCP server for device monitoring, storage analysis, apps, files, logs and encrypted backups",
  "bin": {
    "androidctl": "dist/main/cli.js",
    "androidctl-mcp": "dist/main/mcp.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.check.json",
    "start": "node dist/main/cli.js",
    "mcp": "node dist/main/mcp.js",
    "test": "node --test --import tsx \"test/**/*.test.ts\"",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.15.21",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
