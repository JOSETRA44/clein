# Telegram user MTProto credentials. Never commit real values.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_PATH=%LOCALAPPDATA%\\androidctl\\telegram.session

# Backup encryption secret (min 12 characters). Prefer setting it per session.
ANDROIDCTL_BACKUP_SECRET=

# read-only refuses every state-changing operation (CLI and MCP). Default: standard.
ANDROIDCTL_POLICY=standard
# Bearer token for `androidctl-mcp --http`. Generated at startup when empty.
ANDROIDCTL_MCP_TOKEN=
